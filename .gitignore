# --- 抠图模型二进制：绝不进仓库 ---
# 模型由 .github/workflows/build-apk.yml 在 CI 构建时联网下载并打入 APK，
# 不提交到 git，规避 GitHub 25MB 网页上传 / 100MB push 硬限制。
*.tflite
*.lite
*.tfl

# --- Flutter / Dart 标准忽略 ---
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
flutter_*.png
analysis_options.yaml

# --- Android ---
/android/app/debug/
/android/app/profile/
/android/app/release/
*.apk
*.aab
/android/.gradle/
/android/captures/
/android/local.properties
**/android/**/gradle-wrapper.jar
**/android/**/gradlew
**/android/**/gradlew.bat
**/android/**/Gradlew
*.jks
*.keystore

# --- iOS / macOS ---
/ios/Flutter/Flutter.framework/
/ios/Flutter/Flutter.podspec
/ios/Flutter/Generated.xcconfig
/ios/Flutter/ephemeral/
/ios/**/Pods/
/ios/**/.symlinks/
/ios/**/Flutter/Flutter.framework/
*.mode1v3
*.mode2v3
*.moved-aside
*.pbxuser
*.perspectivev3
**/xcuserdata/
*.xcconfig

# --- 通用 ---
.idea/
.vscode/
*.iml
.DS_Store
~/android/
